{
  "name": "recipe-medusa",
  "version": "0.0.1",
  "description": "Medusa v2.19 commerce backend for Zerops, with PostgreSQL, Valkey, Meilisearch, MinIO, SMTP, Stripe, and draft orders.",
  "author": "Zerops",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zeropsio/recipe-medusa.git"
  },
  "homepage": "https://github.com/zeropsio/recipe-medusa",
  "bugs": {
    "url": "https://github.com/zeropsio/recipe-medusa/issues"
  },
  "keywords": [
    "medusa",
    "ecommerce",
    "zerops",
    "nodejs",
    "starter"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "migrate": "medusa db:migrate --execute-all-links",
    "syncLinks": "medusa db:sync-links --execute-all",
    "createInitialSuperadmin": "bash -c 'err=$(medusa user -e \"$SUPERADMIN_EMAIL\" -p \"$SUPERADMIN_PASSWORD\" 2>&1) || { echo \"$err\" >&2; echo \"$err\" | grep -qi \"already exists\"; }'",
    "seedInitialData": "medusa exec ./src/scripts/seed.js",
    "addInitialSearchDocuments": "medusa exec ./src/scripts/search-index.js",
    "setInitialPublishableKey": "bash -c 'token=$(medusa exec ./src/scripts/output-publishable-key.js | grep -o \"<PK_TOKEN>.*</PK_TOKEN>\" | sed \"s/<PK_TOKEN>//g;s/<\\/PK_TOKEN>//g\" | tr -d \"\\n\\r\"); test -n \"$token\" || { echo \"No publishable key token extracted\" >&2; exit 1; }; zsc setEnv CHANNEL_PUBLISHABLE_KEY \"$token\" --sensitive'",
    "reloadNextstoreEnv": "bash -c 'test -n \"$NEXTSTORE_RELOAD_SECRET\" || exit 0; curl -sf --max-time 15 -X POST -H \"x-reload-secret: $NEXTSTORE_RELOAD_SECRET\" http://nextstore:8000/api/internal/reload-env || echo \"reloadNextstoreEnv: nextstore reload skipped (not running yet).\" >&2'"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/caching": "2.19.0",
    "@medusajs/caching-redis": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@tanstack/react-query": "5.102.8",
    "awilix": "8.0.1",
    "meilisearch": "0.60.0",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "posthog-node": "5.51.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/mime": "1.3.5",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "mime": "1.6.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "resolutions": {
    "lodash": "4.18.1",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "jws": "3.2.3",
    "fast-uri": "3.1.5",
    "ajv": "8.18.0",
    "uuid": "11.1.1",
    "qs": "6.14.2",
    "glob": "10.5.0",
    "browserslist": "4.28.7",
    "immutable": "4.3.9",
    "@babel/helpers": "7.27.0",
    "@babel/runtime": "7.27.0",
    "jest/minimatch": "3.1.4",
    "jest/**/minimatch": "3.1.4",
    "jest/**/brace-expansion": "1.1.18",
    "@jest/**/minimatch": "3.1.4",
    "@jest/**/brace-expansion": "1.1.18",
    "@istanbuljs/load-nyc-config/js-yaml": "3.15.1",
    "@medusajs/**/minimatch": "9.0.7",
    "@medusajs/**/brace-expansion": "2.0.2",
    "express/path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
